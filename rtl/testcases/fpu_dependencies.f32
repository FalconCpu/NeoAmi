# Test RAW (Read After Write) dependencies
# Test scoreboarding with dependent FPU operations

# Simple dependency chain
ld $1, 2.0
ld $2, 3.0
fadd $3, $1, $2      # $3 = 5.0
fmul $4, $3, $2      # $4 = 15.0 (depends on $3)
fsub $5, $4, $1      # $5 = 13.0 (depends on $4)
fdiv $6, $5, $3      # $6 = 2.6 (depends on $5 and $3)

# Multiple dependencies converging
ld $7, 4.0
ld $8, 2.0
fadd $9, $7, $8      # $9 = 6.0
fsub $10, $7, $8     # $10 = 2.0
fmul $11, $9, $10    # $11 = 12.0 (depends on both $9 and $10)

# Long dependency chain
ld $12, 1.0
fadd $13, $12, $12   # $13 = 2.0
fadd $14, $13, $13   # $14 = 4.0
fadd $15, $14, $14   # $15 = 8.0
fadd $16, $15, $15   # $16 = 16.0
fadd $17, $16, $16   # $17 = 32.0

# WAW (Write After Write) - same destination
ld $18, 5.0
ld $19, 10.0
fadd $20, $18, $19   # $20 = 15.0
fmul $20, $18, $19   # $20 = 50.0 (overwrites previous)

# Independent operations (should parallelize)
ld $21, 7.0
ld $22, 3.0
ld $23, 4.0
ld $24, 2.0
fadd $25, $21, $22   # Independent
fadd $26, $23, $24   # Independent
fmul $27, $25, $26   # Depends on both

# Store final results
ld $28, $6
ld $29, $11
ld $30, $17

ld $30,0
ret
