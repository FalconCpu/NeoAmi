# Basic subtraction tests
ld $1, 5.0
ld $2, 3.0
fsub $3, $1, $2      # 5.0 - 3.0 = 2.0

ld $4, 10.5
ld $5, 10.5
fsub $6, $4, $5      # 10.5 - 10.5 = 0.0

ld $7, 3.0
ld $8, 5.0
fsub $9, $7, $8      # 3.0 - 5.0 = -2.0

ld $10, -7.5
ld $11, 2.5
fsub $12, $10, $11   # -7.5 - 2.5 = -10.0

ld $13, -4.0
ld $14, -6.0
fsub $15, $13, $14   # -4.0 - (-6.0) = 2.0

# Store results for checking
ld $20, $3
ld $21, $6
ld $22, $9
ld $23, $12
ld $24, $15

ld $30, 0
ret
