jmp test

exception_handler:
    cfg $10, !epc
    cfg $11, !ecause
    cfg $12, !edata
    add $13, $10, 4     # move past the faulting instruction
    cfg !epc, $13
    rte

test:
    ld $1, 0x12345678
    dcw 0xFFFFFFFF        # Invalid instruction (not defined in the ISA)
    ld $2, 0x9ABCDEF0     # This instruction should be skipped
    ld $30,0
    ret


