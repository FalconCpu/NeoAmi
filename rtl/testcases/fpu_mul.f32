# Basic multiplication tests
ld $1, 2.0
ld $2, 3.0
fmul $3, $1, $2      # 2.0 * 3.0 = 6.0

ld $4, 0.5
ld $5, 4.0
fmul $6, $4, $5      # 0.5 * 4.0 = 2.0

ld $7, -2.5
ld $8, 3.0
fmul $9, $7, $8      # -2.5 * 3.0 = -7.5

ld $10, -4.0
ld $11, -2.0
fmul $12, $10, $11   # -4.0 * -2.0 = 8.0

ld $13, 100.0
ld $14, 0.01
fmul $15, $13, $14   # 100.0 * 0.01 = 1.0

ld $16, 1.5
ld $17, 0.0
fmul $18, $16, $17   # 1.5 * 0.0 = 0.0

# Store results for checking
ld $20, $3
ld $21, $6
ld $22, $9
ld $23, $12
ld $24, $15
ld $25, $18

ld $30, 0
ret
