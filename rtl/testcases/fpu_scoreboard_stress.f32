# Scoreboard stress test - many operations in flight
# Tests the hardware's ability to track multiple outstanding FPU operations

# Initialize many registers with values
ld $1, 1.0
ld $2, 2.0
ld $3, 3.0
ld $4, 4.0
ld $5, 5.0
ld $6, 6.0
ld $7, 7.0
ld $8, 8.0

# Fire off many independent operations (should execute in parallel)
fadd $9, $1, $2      # Independent
fadd $10, $3, $4     # Independent
fadd $11, $5, $6     # Independent
fadd $12, $7, $8     # Independent
fmul $13, $1, $3     # Independent
fmul $14, $2, $4     # Independent
fmul $15, $5, $7     # Independent
fmul $16, $6, $8     # Independent

# Now create dependencies on the results above
fadd $17, $9, $10    # Depends on $9, $10
fadd $18, $11, $12   # Depends on $11, $12
fmul $19, $13, $14   # Depends on $13, $14
fmul $20, $15, $16   # Depends on $15, $16

# Another layer of dependencies
fsub $21, $17, $18   # Depends on $17, $18
fdiv $22, $19, $20   # Depends on $19, $20

# Complex dependency web
fadd $23, $21, $1    # Depends on $21
fmul $24, $22, $2    # Depends on $22
fsub $25, $23, $24   # Depends on $23, $24

# More parallel operations mixed with dependencies
ld $26, 10.0
ld $27, 20.0
fadd $28, $26, $1    # Semi-independent
fadd $29, $27, $2    # Semi-independent
fmul $30, $28, $29   # Depends on $28, $29
fdiv $31, $30, $25   # Depends on $30, $25

# Reuse registers (test WAW hazards)
fadd $9, $31, $1     # Reuse $9, depends on $31
fmul $10, $9, $2     # Depends on new $9
fsub $11, $10, $3    # Depends on new $10

# Final accumulation with many dependencies
fadd $1, $11, $21
fadd $2, $1, $22
fadd $3, $2, $23
fadd $4, $3, $24
fadd $5, $4, $25

ld $30, $5
ld $30,0
ret
