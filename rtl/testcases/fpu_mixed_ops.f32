# Mixed FPU operations stress test
# Exercises all four operations with complex dependencies

# Compute: ((a + b) * (c - d)) / e
ld $1, 10.0          # a
ld $2, 5.0           # b
ld $3, 8.0           # c
ld $4, 2.0           # d
ld $5, 3.0           # e

fadd $6, $1, $2      # a + b = 15.0
fsub $7, $3, $4      # c - d = 6.0
fmul $8, $6, $7      # 15.0 * 6.0 = 90.0
fdiv $9, $8, $5      # 90.0 / 3.0 = 30.0

# Compute: (a * b) + (c / d) - e
ld $10, 4.0
ld $11, 3.0
ld $12, 12.0
ld $13, 4.0
ld $14, 2.0

fmul $15, $10, $11   # 4.0 * 3.0 = 12.0
fdiv $16, $12, $13   # 12.0 / 4.0 = 3.0
fadd $17, $15, $16   # 12.0 + 3.0 = 15.0
fsub $18, $17, $14   # 15.0 - 2.0 = 13.0

# More complex expression: ((a / b) + (c * d)) * ((e - f) / g)
ld $19, 20.0
ld $20, 5.0
ld $21, 3.0
ld $22, 2.0
ld $23, 10.0
ld $24, 4.0
ld $25, 2.0

fdiv $26, $19, $20   # 20.0 / 5.0 = 4.0
fmul $27, $21, $22   # 3.0 * 2.0 = 6.0
fadd $28, $26, $27   # 4.0 + 6.0 = 10.0
fsub $29, $23, $24   # 10.0 - 4.0 = 6.0
fdiv $30, $29, $25   # 6.0 / 2.0 = 3.0
fmul $31, $28, $30   # 10.0 * 3.0 = 30.0

# Store key results
ld $1, $9
ld $2, $18
ld $3, $31

ld $30, 0
ret
