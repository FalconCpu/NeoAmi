# Test byte (8-bit) load and store operations

# Test basic byte store and load
ld $1, 0x100
ld $2, 0x42
stb $2, $1[0]      # Store byte at 0x100
ldb $3, $1[0]      # Load back, $3 = 0x00000042

# Test byte with sign extension (negative byte)
ld $4, 0x110
ld $5, 0xFF        # -1 as 8-bit
stb $5, $4[0]      # Store byte 0xFF at 0x110
ldb $6, $4[0]      # $6 = 0xFFFFFFFF (sign-extended from 0xFF)

# Test positive byte (no sign extension needed)
ld $7, 0x120
ld $8, 0x7F        # Max positive 8-bit value
stb $8, $7[0]      # Store at 0x120
ldb $9, $7[0]      # $9 = 0x0000007F

# Test zero byte
ld $10, 0x130
ld $11, 0x00
stb $11, $10[0]    # Store 0
ldb $12, $10[0]    # $12 = 0x00000000

# Test multiple bytes in adjacent locations
ld $13, 0x200
ld $14, 0x11
ld $15, 0x22
ld $16, 0x33
ld $17, 0x44
stb $14, $13[0]    # Store at 0x200
stb $15, $13[1]    # Store at 0x201
stb $16, $13[2]    # Store at 0x202
stb $17, $13[3]    # Store at 0x203

# Load them back
ldb $18, $13[0]    # $18 = 0x00000011
ldb $19, $13[1]    # $19 = 0x00000022
ldb $20, $13[2]    # $20 = 0x00000033
ldb $21, $13[3]    # $21 = 0x00000044

# Test negative bytes (sign extension)
ld $22, 0x300
ld $23, 0x80       # -128 as 8-bit (most negative)
stb $23, $22[0]    # Store at 0x300
ldb $24, $22[0]    # $24 = 0xFFFFFF80 (sign-extended)

ld $25, 0xFE       # -2 as 8-bit
stb $25, $22[1]    # Store at 0x301
ldb $26, $22[1]    # $26 = 0xFFFFFFFE (sign-extended)

# Test overwriting byte
ld $27, 0x400
ld $28, 0xAA
stb $28, $27[0]    # Store at 0x400
ldb $29, $27[0]    # $29 = 0xFFFFFFAA (negative, sign-extended)
ld $30, 0x55
stb $30, $27[0]    # Overwrite
ldb $31, $27[0]    # $31 = 0x00000055 (positive)

# Test storing only lower 8 bits of larger value
ld $1, 0x500
ld $2, 0xDEADBEEF
stb $2, $1[0]      # Stores 0xEF (lower 8 bits)
ldb $3, $1[0]      # $3 = 0xFFFFFFEF (sign-extended from 0xEF)

# Test bytes at various offsets
ld $4, 0x600
ld $5, 0x12
ld $6, 0x34
ld $7, 0x56
ld $8, 0x78
stb $5, $4[0]      # Byte 0
stb $6, $4[1]      # Byte 1
stb $7, $4[2]      # Byte 2
stb $8, $4[3]      # Byte 3
ldw $9, $4[0]      # Read as word: $9 = 0x78563412 (little-endian)

# Test boundary values
ld $10, 0x700
ld $11, 0x01       # Smallest positive
stb $11, $10[0]
ldb $12, $10[0]    # $12 = 0x00000001

ld $13, 0x7F       # Largest positive 8-bit
stb $13, $10[1]
ldb $14, $10[1]    # $14 = 0x0000007F

ld $15, 0x81       # Negative value (-127)
stb $15, $10[2]
ldb $16, $10[2]    # $16 = 0xFFFFFF81 (sign-extended)

# Test reading individual bytes from a word
ld $17, 0x800
ld $18, 0x12345678
stw $18, $17[0]    # Store word
ldb $19, $17[0]    # Byte 0: $19 = 0x00000078
ldb $20, $17[1]    # Byte 1: $20 = 0x00000056
ldb $21, $17[2]    # Byte 2: $21 = 0x00000034
ldb $22, $17[3]    # Byte 3: $22 = 0x00000012

# Test writing four bytes to make a word
ld $23, 0x900
ld $24, 0xEF
ld $25, 0xBE
ld $26, 0xAD
ld $27, 0xDE
stb $24, $23[0]    # Byte 0
stb $25, $23[1]    # Byte 1
stb $26, $23[2]    # Byte 2
stb $27, $23[3]    # Byte 3
ldw $28, $23[0]    # Read as word: $28 = 0xDEADBEEF

# Test ASCII characters
ld $29, 0xA00
ld $30, 65         # 'A'
stb $30, $29[0]
ld $31, 66         # 'B'
stb $31, $29[1]
ld $1, 67          # 'C'
stb $1, $29[2]
ldb $2, $29[0]     # $2 = 65
ldb $3, $29[1]     # $3 = 66
ldb $4, $29[2]     # $4 = 67

# Test pattern across memory
ld $5, 0xB00
ld $6, 0
ld $7, 8           # Counter
byte_pattern_loop:
    stb $6, $5[0]
    add $5, $5, 1
    add $6, $6, 1
    sub $7, $7, 1
    bne $7, $0, byte_pattern_loop

# Verify pattern
ld $8, 0xB00
ldb $9, $8[0]      # $9 = 0
ldb $10, $8[1]     # $10 = 1
ldb $11, $8[2]     # $11 = 2
ldb $12, $8[3]     # $12 = 3
ldb $13, $8[4]     # $13 = 4

ld $30, 0
ret
