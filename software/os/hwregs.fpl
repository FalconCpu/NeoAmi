
class HwRegs 
    var seven_seg      : Int  # 6 digit hexadecimal seven segment display
    var ledr           : Int  # 10 LEDs
    var sw             : Int  # 10 Switches
    var key            : Int  # 4 Push buttons
    var uart_tx        : Int  # Write = byte of data to transmit, read = number of slots free in fifo
    var uart_rx        : Int  # 1 byte of data from the uart, -1 if no data
    var mouse_x        : Int  # Mouse X coordinate
    var mouse_y        : Int  # Mouse Y coordinate
    var mouse_buttons  : Int  # Mouse buttons (bit 0 = left, bit 1 = right, bit 2 = middle)
    var keyboard       : Int  # Keyboard scan code, -1 if no key pressed
    var timer          : Int  # 32 bit free running timer
    var i2c_out        : Int  # 
    var simulation     : Int  # Reads as 1 in simulation, 0 in hardware
    var overflow       : Int  # Overflow flag for fifos
    var vga_pos        : Int  # Current VGA row (Y) being drawn
    var vga_obj_list   : IrisSprite?  # Base address of the object list for the VGA rasterizer
    var sd_card_ctrl   : Int  # 0: Assert CS for SD card, 1: Deassert CS
    var sd_card_cmd_hi : Int  # Upper 16 bits of the SD card command
    var sd_card_cmd_lo : Int  # Lower 32 bits of the SD card command - reads as -1 once the command has been accepted
    var sd_card_rx     : Int  # Data received from the SD card over SPI - reads as -1 if no data is available

const hwregs = unsafe(0xE0000000 as HwRegs)


class HwAudio
    var start_address  : Int    # The base address of the audio buffer in main memory
    var end_address    : Int    # The end address of the audio buffer
    var loop_address   : Int    # The loop start address of the audio
    var volume         : Int    # The volume level for the audio output. [15:0]=Left channel, [31:16]=Right channel
                                # Default volume=0x0100 for each channel
    var frequency      : Int    # sample rate. 0x10000=48kHz, 0x8000=24kHz, 0x4000=12kHz etc
    var sample_out     : Int    # The current audio sample output
    var reserved1      : Int    # Reserved for future use
    var reserved2      : Int    # Reserved for future use

const hwAudio0 = unsafe(0xE0000200 as HwAudio)
const hwAudio1 = unsafe(0xE0000220 as HwAudio)
const hwAudio2 = unsafe(0xE0000240 as HwAudio)
const hwAudio3 = unsafe(0xE0000260 as HwAudio)
const hwAudio4 = unsafe(0xE0000280 as HwAudio)
const hwAudio5 = unsafe(0xE00002A0 as HwAudio)
const hwAudio6 = unsafe(0xE00002C0 as HwAudio)
const hwAudio7 = unsafe(0xE00002E0 as HwAudio)

class HwGemma
    var start          : Int  # One bit per processing unit. Writing a 1 to a bit starts the corresponding processing unit.
    var busy           : Int  # One bit per processing unit. A bit is set to 1 when the corresponding processing unit is busy, and cleared to 0 when it is idle.
    var auto           : Int  # One bit per processing unit. When set to 1, the corresponding processing unit will automatically start processing as soon as its input data is available, and its output buffer is free. When cleared to 0, the processing unit will only start when the START bit is set.
    var output_ptr     : Int  # The destination write pointer for the triangle setup stage. This holds an address in main memory where the triangle data will be written. The address is a 32-bit value, and must be aligned to a 16-byte boundary.
    var clip_x1        : Int  # The left edge of the clipping rectangle. Used in the triangle setup stage. This is a 16-bit signed integer, and must be less than CLIP_X2.
    var clip_y1        : Int  # The top edge of the clipping rectangle. Used in the triangle setup stage. This is a 16-bit signed integer, and must be less than CLIP_Y2.
    var clip_x2        : Int  # The right edge of the clipping rectangle. Used in the triangle setup stage. This is a 16-bit signed integer, and must be greater than CLIP_X1.
    var clip_y2        : Int  # The bottom edge of the clipping rectangle. Used in the triangle setup stage. This is a 16-bit signed integer, and must be greater than CLIP_Y1.
    var texture_addr   : Int  # The base address of the texture in main memory. Used in the triangle setup stage for textured triangles. This is a 32-bit value, and must be aligned to a 16-byte boundary.
    var texture_stride : Int  # The stride of the texture in bytes. Used in the triangle setup stage for textured triangles. This is a 16-bit unsigned integer, and must be greater than 0.

const hwGemma = unsafe(0xE0020000 as HwGemma)

class HwGemmaTriangleSetup
    var v0_x      : Int  # The X coordinate of the topmost vertex in screen space. S12.4 format.
    var v0_y      : Int  # The Y coordinate of the topmost vertex in screen space. S12.4 format.
    var v0_z      : Int  # The inverse depth value of the topmost vertex. Pixels with a higher Z value are closer to the camera. U20 format.
    var v0_r      : Int  # The red color component, or U coordinate of the topmost vertex. S12.12 format.
    var v0_g      : Int  # The green color component, or V coordinate of the topmost vertex. S12.12 format.
    var v0_b      : Int  # The blue color component, or brighness value, of the topmost vertex. S12.12 format.
    var reserved1 : Int  # Reserved for future use. Must be set to 0.
    var reserved2 : Int  # Reserved for future use. Must be set to 0
    var v1_x      : Int  # The X coordinate of the middle vertex in screen space. S12.4 format.
    var v1_y      : Int  # The Y coordinate of the middle vertex in screen space. S12.4 format.
    var v1_z      : Int  # The inverse depth value of the middle vertex. Pixels with a higher Z value are closer to the camera. U20 format.
    var v1_r      : Int  # The red color component, or U coordinate of the middle vertex. S12.12 format.
    var v1_g      : Int  # The green color component, or V coordinate of the middle vertex. S12.12 format.
    var v1_b      : Int  # The blue color component, or brighness value, of the middle vertex. S12.12 format.
    var reserved3 : Int  # Reserved for future use. Must be set to 0.   
    var reserved4 : Int  # Reserved for future use. Must be set to 0.
    var v2_x      : Int  # The X coordinate of the bottommost vertex in screen space. S12.4 format.
    var v2_y      : Int  # The Y coordinate of the bottommost vertex in screen space. S12.4 format.
    var v2_z      : Int  # The inverse depth value of the bottommost vertex. Pixels with a higher Z value are closer to the camera. U20 format.
    var v2_r      : Int  # The red color component, or U coordinate of the bottommost vertex. S12.12 format.
    var v2_g      : Int  # The green color component, or V coordinate of the bottommost vertex. S12.12 format.
    var v2_b      : Int  # The blue color component, or brighness value, of the bottommost vertex. S12.12 format.
    var reserved5 : Int  # Reserved for future use. Must be set to 0.
    var reserved6 : Int  # Reserved for future use. Must be set to 0.
    var reserved7 : Int  # Reserved for future use. Must be set to 0.
    var reserved8 : Int  # Reserved for future use. Must be set to 0.
    var reserved9 : Int  # Reserved for future use. Must be set to 0.
    var reserved10: Int  # Reserved for future use. Must be set to 0.
    var reserved11: Int  # Reserved for future use. Must be set to 0.
    var reserved12: Int  # Reserved for future use. Must be set to 0.
    var reserved13: Int  # Reserved for future use. Must be set to 0.
    var flags     : Int  # Control flags for the triangle setup operation, see below.   

const hwGemmaTriangleSetup = unsafe(0xE0020500 as HwGemmaTriangleSetup)


fun uartTx(c:Char)
    # wait for space in tx fifo
    var a = -1
    repeat
        a = hwregs.uart_tx
    until a>8
    hwregs.uart_tx = (c as Int)

fun dummy()
    val x = 1

fun waitForVBlank()
    # hwregs.vga_pos reads as negative when the VGA is in the vertical blanking period, and as a positive number when it is drawing the visible area.  This function waits for the start of the next vertical blanking period.
    while hwregs.vga_pos <0
        # kprintf("< %d\n", hwregs.vga_pos)
        dummy()

    while hwregs.vga_pos >=0
        # kprintf("> %d\n", hwregs.vga_pos)
        dummy()