IRIS_BASE = 0xE0010000

ld $1, IRIS_BASE
ld $2, data_start
ld $3, data_end

loop:
ldw $4, $2[0]
stw $4, $1[0]
add $2, $2, 4
add $1, $1, 4
bne $2, $3, loop


ld $3, 0xE0012000       # End of IRIS memory space
zero_loop:
stw 0, $1[0]
add $1, $1, 4
bne $1, $3, zero_loop

forever:
jmp forever

data_start:
dcw 0x00000012
dcw 0x00320280
dcw 0x12c000fa
dcw 0x19000320
dcw 0x3c000fa0
dcw 0x00000800
dcw 0x00000050
dcw 0x00000000
dcw 0x0da70ff0
dcw 0x0ff02f04
dcw 0x2f040da7
dcw 0x0da70ff0
dcw 0x00002f04
dcw 0x00000000
dcw 0x00000000
dcw 0x00010040
dcw 0x00000012
dcw 0x00640280
dcw 0x064000c8
dcw 0x0c800640
dcw 0x38000c80
dcw 0x00001000
dcw 0x000000a0
dcw 0x00000000
dcw 0x00000ff0
dcw 0x00007ae7
dcw 0x0d991b33
dcw 0x24cd0000
dcw 0x00001b33
dcw 0x00000000
dcw 0x00000000
dcw 0x00000000
data_end:
