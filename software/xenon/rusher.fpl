
class Rusher(xpos: Int, ypos: Int, val dx:Int, val dy:Int) : Actor(xpos, ypos)
    var t = 0
    var hit_points = 2

    override fun update()
        x += dx
        y += dy
        t += 1

        if (y > 480 and dy>0) or (y < -32 and dy<0) or (x > 640 and dx>0) or (x < -32 and dx<0)
            active = false
            return

        if y>-32
            val imageIndex = (t/8) % 24
            val sprite = scene.newSprite()
            sprite.setBitmap(x, y, spriteManifest[SPRITE_RUSHER + imageIndex], spriteDataPtr)
            sprite.setZ(32)
            sprite.reserved2 = unsafe(this as Int)   # indicate this is an enemy sprite
            scene.addObject(sprite)

    override fun onHit()
        hit_points -= 1
        if hit_points <= 0
            val explosion = new Explosion(x, y, 1)
            actorList.add(explosion)
            active = false