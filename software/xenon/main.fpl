
# Globals for the data pointers
var spriteDataPtr = 0
var backdropDataPtr : Pointer<Char>
var tilesDataPtr : Pointer<Char>
var tileMap : Pointer<Short>
var actorList : ActorList

var scene : GfxScene
var keyboard : Keyboard

fun delay(count: Int)
    for i in 0..count
        val dummy = 1

fun waitVsync()
    # hwregs.seven_seg = hwregs.vga_pos
    # kprintf("\n")
    # kprintf("VGA position: %d\n", hwregs.vga_pos)
    while hwregs.vga_pos <=0
        delay(1000)
    while hwregs.vga_pos > 0
        delay(1000)


fun loadGraphicsData() 
    kprintf("Starting to load graphics data\n")

    val spritePalette = loadFile("export/sprites_palette.bin")
    if spritePalette is Error then abort 1
    kprintf("Loaded sprite palette\n")
    val spritePalettePtr = unsafe(spritePalette as Pointer<Int>)
    for i in 0..255
        VGA_PALETTE[i] = spritePalettePtr[i]

    kprintf("About to load backdrop palette\n")
    val backdropPalette = loadFile("export/backdrop_ham_palette.bin")
    if backdropPalette is Error then abort 1
    val backdropPalettePtr = unsafe(backdropPalette as Pointer<Int>)
    for i in 0..255
        VGA_PALETTE[i+256] = backdropPalettePtr[i]
    
    val tilesData = loadFile("export/tiles.bin")
    if tilesData is Error then abort 1
    tilesDataPtr = tilesData
    kprintf("Loaded tiles data at %x\n", tilesDataPtr)

    val backdropData = loadFile("export/backdrop_ham.bin")
    if backdropData is Error then abort 1
    backdropDataPtr = backdropData

    val spriteData = loadFile("export/sprites.bin")
    if spriteData is Error
        kprintf("Failed to load sprite data\n")
        abort 1
    kprintf("Loaded sprite data at %x\n", spriteData)
    spriteDataPtr = unsafe(spriteData as Int)

    # val spriteData = allocatePageAndLoadFile("export/sprites.bin")
    # if spriteData is Error then abort 1
    # spriteDataPtr = pageIdToAddress(spriteData)


    val tilesPalette = loadFile("export/palette.bin")
    if tilesPalette is Error then abort 1
    val tilesPalettePtr = unsafe(tilesPalette as Pointer<Int>)
    for i in 0..255
        VGA_PALETTE[i+512] = tilesPalettePtr[i]


    val tileMapData = loadFile("export/tilemap.bin")
    if tileMapData is Error then abort 1
    tileMap = unsafe(tileMapData as Pointer<Short>)

    # Set palette for HUD
    VGA_PALETTE[3*256 + 1] = 0xFF0000   # Color 1 = Red
    VGA_PALETTE[3*256 + 2] = 0x00FF00   # Color 2 = Green
    VGA_PALETTE[3*256 + 3] = 0x0000FF   # Color 3 = Blue
    VGA_PALETTE[3*256 + 4] = 0xFFFFFF   # Color 4 = White



fun drawBackground(time:Int)
    val backdropSprite = scene.newSprite()
    backdropSprite.setBitmap(backdropDataPtr, 640, 1)
    backdropSprite.flags = (32 | 16 | 4 | 1) as Short
    backdropSprite.setSizeAndPos(0, 0, 640, 480)
    backdropSprite.setZ(1)
    scene.addObject(backdropSprite)

    val t = if time < 39200 then time else 39200

    # First parallax layer
    val startRow = 1024 - t/64
    val scrollOffset = (t/2) & 31

    # Second parallax layer
    val startRow2 = 1024 - t/32
    val scrollOffset2 = t & 31

    hwregs.seven_seg = 1

    for row in -1..14
        for col in 0..19
            val tileIndex = tileMap[(startRow + row) * 20 + col] as Int
            if tileIndex != 0
                val tileX = col * 32
                val tileY = row * 32 + scrollOffset
                val tileSprite = scene.newSprite()
                tileSprite.setBitmap(tilesDataPtr + tileIndex * 32*32, 32, 2)
                tileSprite.setSizeAndPos(tileX, tileY, 32, 32)
                tileSprite.setZ(8)
                tileSprite.reserved2 = 0        # indicate this is not a enemy sprite
                scene.addObject(tileSprite)

            val tileIndex2 = tileMap[1024*20 + (startRow2 + row) * 20 + col] as Int
            if tileIndex2 != 0
                val tileX = col * 32
                val tileY = row * 32 + scrollOffset2
                val tileSprite = scene.newSprite()
                tileSprite.setBitmap(tilesDataPtr + tileIndex2 * 32*32, 32, 2)
                tileSprite.setSizeAndPos(tileX, tileY, 32, 32)
                tileSprite.setZ(32)
                if tileIndex2 < 40
                    tileSprite.setZ(12)
                tileSprite.reserved2 = 0
                scene.addObject(tileSprite)

            if tileIndex2>0 and tileIndex2<=50 and t&31=0 and row=-1
                spawnObject(tileIndex2,  col*32)

    hwregs.seven_seg = 2


fun main() -> Int!

    val root_entries = fileSystem.listDirectory(0,"export")
    if root_entries is Error
        kprintf("Failed to list root directory: %s \n", root_entries.description)
        abort(0)

    kprintf("List Root directory entries:\n")
    for entry in root_entries
        print(entry)
    freeDirList(root_entries)




    scene = new GfxScene()
    scene.init()
    keyboard = new Keyboard()
    loadGraphicsData()
    actorList = new ActorList()

    val player = new Player()
    # var time = 0x3000
    



    var time = 600
    # time=7000

    hwregs.ledr = 0
    kprintf("Keyboard: %x\n", keyboard)
    kprintf("Player : %x\n", player)

    while true
        time = time + 1
        drawBackground(time)
        for actor in actorList
            actor.update()
        player.update()
        actorList.removeInactive()


        hwregs.seven_seg = time
        waitVsync()
        scene.show()

