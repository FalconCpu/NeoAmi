
class Bullet(xpos: Int, ypos: Int) : Actor(xpos, ypos)
    var velocityX = 0
    var velocityY = -8

    override fun update()
        x += velocityX
        y += velocityY
        if x < 0 or x > 640 or y < 0 or y > 480
            active = false
            return

        val sprite = scene.newSprite()
        sprite.setBitmap(x, y, spriteManifest[SPRITE_MISSILE], spriteDataPtr)
        sprite.reserved2 = 0
        sprite.setZ(32)

        val collision = scene.checkCollision(sprite, 0)
        if collision != null
            val collidedObject = unsafe(collision.reserved2 as Actor?)
            if collidedObject != null
                collidedObject.onHit()
            active = false

        scene.addObject(sprite)